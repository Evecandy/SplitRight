/* pages/joinGroup/joinGroup.acss */
.page-container { display: flex; flex-direction: column; min-height: 100vh; background-color: #f4f4f4; }
.header { background-color: #2ecc71; padding: 25rpx 30rpx; text-align: center; color: #ffffff; }
.header-title { font-size: 36rpx; font-weight: bold; }

.content-area { padding: 30rpx; flex-grow: 1; }

/* Info Card */
.info-card {
  background-color: #ffffff;
  padding: 30rpx;
  border-radius: 15rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.05);
}

.group-details-card .group-title { display: block; font-size: 34rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; text-align: center; }
.detail-item { display: flex; margin-bottom: 10rpx; font-size: 28rpx; line-height: 1.4;}
.detail-label { color: #888; width: 150rpx; /* Adjust width as needed */ flex-shrink: 0; }
.detail-value { color: #444; flex-grow: 1; }
.detail-value.purpose { /* Allow purpose to wrap */ white-space: normal; }

/* Agreement Section */
.agreement-section { margin-bottom: 30rpx; padding: 0 10rpx; }
.agreement-title { display: block; font-size: 28rpx; color: #555; margin-bottom: 10rpx; font-weight: 500;}
.agreement-point { display: block; font-size: 28rpx; color: #555; margin-bottom: 8rpx; line-height: 1.4;}

/* Terms Section */
.terms-section {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 15rpx 10rpx; /* Add padding to make area tappable */
}
.terms-checkbox { margin-right: 15rpx; transform: scale(0.9); /* Adjust checkbox size slightly */ }
.terms-label { font-size: 28rpx; color: #333; }

/* Action Buttons */
.action-button {
  width: 100%;
  padding: 25rpx 0;
  font-size: 32rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
  transition: opacity 0.2s; /* Smooth transition for disabled state */
}
.join-button {display: flex;align-items: center;justify-content: center; background-color: #2ecc71; color: white; }
.join-button[disabled] { opacity: 0.6; background-color: #9aeabc; /* Lighter green when disabled */ }

.cancel-button { display: flex;align-items: center;justify-content: center;background-color: #eeeeee; color: #555; border: 1rpx solid #e0e0e0; }
.cancel-button::after { border: none; }