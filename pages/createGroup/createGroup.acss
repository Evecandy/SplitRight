/* pages/createGroup/createGroup.acss */
.page-container {
  background-color: #f4f4f4;
  min-height: 100vh;
}

.header {
  background-color: #2ecc71;
  padding: 25rpx 30rpx;
  text-align: center;
  color: #ffffff;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.form-container {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
  
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.input-field,
.textarea-field,
.picker-display {
  width: 100%;
  height: 50px;
  background-color: #ffffff;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  /* Include padding in width */
}

.textarea-field {
  height: 120rpx;
}

/* Adjust height */
.picker-display {
  color: #333;
}

.picker-display:empty::before {
  content: attr(placeholder);
  color: #999;
}

/* Show placeholder if empty */

/* Radio Group */
.radio-group {
  display: block;
}

.radio-option {
  display: block;
  background-color: #fff;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
  font-size: 30rpx;
  color: #333;
}

.radio-option radio {
  margin-right: 15rpx;
}

.option-description {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 5rpx;
  margin-left: 45rpx;
  /* Align with text after radio */
}

/* Style checked state if needed */
/* .radio-option[checked] { border-color: #2ecc71; } */

/* Input Group (for members) */
.input-group {
  display: flex;
  align-items: center;
}

.member-input {
  flex-grow: 1;
  margin-right: 15rpx;
}

.add-button {
  background-color: #2ecc71;
  color: white;
  border-radius: 8rpx;
  padding: 15rpx 25rpx;
  line-height: 1;
  /* Adjust for button height */
  font-size: 36rpx;
  font-weight: bold;
  border: none;
}

.create-group-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2ecc71;
  color: #ffffff;
  border-radius: 15rpx;
  font-size: 32rpx;
  padding: 20rpx 80rpx;
  width: auto;
  /* font-weight: bold; */
  margin-top: 20rpx;

}