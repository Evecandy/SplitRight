/* pages/firstContribution/firstContribution.acss */
.page-container { display: flex; flex-direction: column; min-height: 100vh; background-color: #f4f4f4; }
.header { background-color: #2ecc71; padding: 25rpx 30rpx; text-align: center; color: #ffffff; }
.header-title { font-size: 36rpx; font-weight: bold; }

.content-area { padding: 30rpx; flex-grow: 1; }

/* Info Cards */
.info-card {
  background-color: #ffffff;
  padding: 30rpx;
  border-radius: 15rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.05);
}

.group-info-card .group-title { display: block; font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.group-info-card .group-subtitle { display: block; font-size: 28rpx; color: #666; margin-bottom: 8rpx; }
.group-info-card .group-balance { display: block; font-size: 28rpx; color: #666; }

.text-info-card text { display: block; font-size: 28rpx; color: #555; line-height: 1.5; margin-bottom: 8rpx; }
.text-info-card text:last-child { margin-bottom: 0; }

/* Amount Input */
.amount-input-section { margin-bottom: 40rpx; }
.label { display: block; font-size: 28rpx; color: #333; margin-bottom: 15rpx; font-weight: 500; }
.input-container {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx 25rpx;
}
.currency-symbol { font-size: 36rpx; color: #888; margin-right: 15rpx; font-weight: bold; }
.amount-input {
  flex-grow: 1;
  font-size: 40rpx; /* Larger font for amount */
  color: #333;
  text-align: right;
  border: none;
  padding: 0;
  height: auto; /* Reset default height if needed */
  min-height: unset;
}

/* Action Buttons */
.action-button {
  width: 100%;
  padding: 25rpx 0;
  font-size: 32rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
}
.add-contribution-button { display: flex;align-items: center;justify-content: center;background-color: #2ecc71; color: white; }
.skip-button { display: flex;align-items: center;justify-content: center;background-color: #eeeeee; color: #555; border: 1rpx solid #e0e0e0; }
/* Optional: remove default button styles */
.skip-button::after { border: none; }