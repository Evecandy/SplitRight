<view class="page">
  <view class="header">
    <text class="header-text">Group wallet Created!</text>
  </view>
  
  <view class="content">
    <view class="success-icon">
      <icon type="success" size="60" color="#4CAF50" />
    </view>
    
    <text class="success-text">Group Successfully Created</text>
    
    <view class="group-info">
      <text class="info-line">Group ID: {{group.id || 'N/A'}}</text>
      <text class="info-line">Members: {{group.memberCount || 0}} (including you)</text>
      <text class="info-line">Valid until: {{group.validUntil || 'N/A'}}</text>
      <text class="info-line">Approval: {{group.approvalRate || '50%'}} of members</text>
      <text class="info-line">Wallet Balance: KES {{group.walletBalance || 0}}</text>
    </view>
    
    <button class="primary-button" onTap="addFunds">Add Funds Now</button>
    <button class="secondary-button" onTap="goToGroup">Go to Group</button>
  </view>
  
  <view class="loading-overlay" a:if="{{loading}}">
    <loading />
  </view>
</view>