.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  background-color: #4CAF50;
  color: white;
  padding: 16px;
  text-align: center;
  font-weight: bold;
}

.header-text {
  font-size: 18px;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 16px;
}

.success-icon {
  margin: 24px 0;
}

.success-text {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 24px;
}

.group-info {
  width: 100%;
  background-color: #f5f5f5;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 24px;
}

.info-line {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
}

.primary-button {
  background-color: #4CAF50;
  color: white;
  width: 100%;
  padding: 12px;
  border-radius: 4px;
  margin-bottom: 12px;
  font-size: 16px;
}

.secondary-button {
  background-color: white;
  color: #4CAF50;
  width: 100%;
  padding: 12px;
  border: 1px solid #4CAF50;
  border-radius: 4px;
  font-size: 16px;
}

.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
}