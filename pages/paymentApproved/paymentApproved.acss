
.page-container { background-color: #f4f4f4; min-height: 100vh; }
.header { background-color: #2ecc71; padding: 25rpx 30rpx; text-align: center; color: #ffffff; }
.header-title { font-size: 36rpx; font-weight: bold; }

.content-area { padding: 30rpx; }

.details-card {
  background-color: #ffffff;
  padding: 30rpx;
  border-radius: 15rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.05);
}
.bill-title { display: block; font-size: 34rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.amount { display: block; font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 15rpx; }
.detail-text { display: block; font-size: 28rpx; color: #666; margin-bottom: 8rpx; line-height: 1.4; }
.approval-status.approved { color: #27ae60; /* Green color for approved status */ }
.status-indicator { font-weight: bold; color: #27ae60; margin-top: 10rpx;}


.section-label { display: block; font-size: 28rpx; color: #333; margin-bottom: 10rpx; font-weight: 500; }

.receipt-section { margin-bottom: 30rpx; }
.receipt-view-area {
  background-color: #eeeeee;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
  min-height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.receipt-thumbnail-display {
    max-width: 100%;
    max-height: 200rpx;
    margin-bottom: 15rpx;
    border-radius: 4rpx;
}
.view-receipt-button {
    background-color: #dcdcdc;
    color: #333;
    border-radius: 20rpx;
    padding: 5rpx 25rpx;
}
.view-receipt-button[disabled] {
    background-color: #f0f0f0;
    color: #aaa;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #eeeeee;
  color: #555;
  border: 1rpx solid #e0e0e0;
  width: 100%;
  margin-top: 40rpx;
  padding: 25rpx 0;
  font-size: 32rpx;
  border-radius: 10rpx;
}
.back-button::after { border: none; }